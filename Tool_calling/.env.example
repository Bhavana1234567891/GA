# Local default is SQLite. Switch to Postgres when you are ready.
DATABASE_URL=sqlite:///./ledger.db

# --- LLM (optional) ---
# Leave OPENAI_API_KEY empty to run in rules mode (no paid API needed).
# Rules mode still uses the same four tools — you can see every call in the UI.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Set this to use Groq, Ollama, or any OpenAI-compatible endpoint.
# Examples:
#   https://api.groq.com/openai/v1
#   http://host.docker.internal:11434/v1
LLM_BASE_URL=
